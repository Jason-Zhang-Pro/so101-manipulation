<?xml version="1.0"?>
<package format="3">
  <name>so101_bringup</name>
  <version>0.1.0</version>

  <description>Launch and runtime configuration for the SO-101 capstone project.</description>

  <maintainer email="tiger@todo.todo">Tiger Yan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>so101_description</exec_depend>
  <exec_depend>so101_gazebo</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
