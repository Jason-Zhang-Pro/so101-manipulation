  </link>

  <!-- Joint from gripper to moving_jaw_so101_v1 -->
  <joint name="gripper" type="revolute">
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-08 -1.41553e-15"/>
    <parent link="gripper_link"/>
    <child link="moving_jaw_so101_v1_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
  </joint>

  <!-- Joint from wrist to gripper -->
  <joint name="wrist_roll" type="revolute">
    <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
  </joint>

  <!-- Joint from lower_arm to wrist -->
  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
  </joint>

  <!-- Joint from upper_arm to lower_arm -->
  <!-- Note: 5-degree calibration offset applied to joint limits -->
  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.11257 -0.028 1.73763e-16" rpy="-3.63608e-16 8.74301e-16 1.5708"/>
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.69" upper="1.69"/>
  </joint>

  <!-- Joint from shoulder to upper_arm -->
  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533"/>
  </joint>

  <!-- Joint from base to shoulder -->
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

  <joint name="top_camera_joint" type="fixed">
    <origin xyz="0.528 0.000 0.3976" rpy="0 1.954769 0"/>
    <parent link="base_link"/>
    <child link="top_camera_link"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="shoulder_pan">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="shoulder_lift">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="elbow_flex">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_flex">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wrist_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>


  <!-- Contact evidence for task scoring only. Monitor the functional finger
       collision, not the wrist/body. Collision names must also be verified in
       the generated SDF before enabling formal grasp scoring in Gazebo. -->
  <gazebo reference="gripper_link">
    <sensor name="fixed_finger_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <contact>
        <topic>/so101/contacts/raw/fixed_finger</topic>
        <collision>gripper_link_fixed_joint_lump__generated_wrist_roll_follower_so101_v1_part_01_collision_2</collision>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="moving_jaw_so101_v1_link">
    <sensor name="moving_finger_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <contact>
        <topic>/so101/contacts/raw/moving_finger</topic>
        <collision>moving_jaw_so101_v1_link_fixed_joint_lump__generated_moving_jaw_so101_v1_part_01_collision_1</collision>
      </contact>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
    <!-- Semantic segmentation label for whole robot model -->
    <plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label">
      <label>10</label>
    </plugin>
  </gazebo>

    <!-- ========================================================= -->
  <!-- Top / fixed camera                                        -->
  <!-- Raw pinhole horizontal FOV: 100 deg = 1.745329 rad -->
  <!-- Resolution: 800 x 600 -->
  <!-- Raw sensor rate: 45 Hz; policy sampling rate: 30 Hz -->
  <!-- ========================================================= -->
  <gazebo reference="top_camera_link">
    <sensor name="top_camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>45</update_rate>
      <topic>/top_camera/image_raw</topic>

      <camera>
        <camera_info_topic>/top_camera/camera_info</camera_info_topic>

        <!-- Temporary effective pinhole FOV inferred from the 0.60 m table span -->
        <horizontal_fov>1.745329</horizontal_fov>

        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>

    <sensor name="top_camera_segmentation_sensor" type="segmentation">
      <always_on>false</always_on>
      <update_rate>60</update_rate>
      <topic>/top_camera/segmentation</topic>

      <camera>
        <segmentation_type>semantic</segmentation_type>
        <camera_info_topic>/top_camera/segmentation/camera_info</camera_info_topic>

        <!-- Keep segmentation geometry identical to the RGB camera -->
        <horizontal_fov>1.745329</horizontal_fov>

        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ========================================================= -->
  <!-- Gripper camera                                            -->
  <!-- Assumed horizontal FOV: 50 deg = 0.872665 rad             -->
  <!-- Resolution: 640 x 480                                     -->
  <!-- Frame rate: 30 Hz, initial simulation test value           -->
  <!-- ========================================================= -->
  <gazebo reference="gripper_camera_link">
    <sensor name="gripper_camera_sensor" type="camera">

      <!-- Preserve the currently verified sensor position/orientation -->
      <pose>0.007 -0.0015 0.0001 0 -1.570796 -1.570796</pose>

      <always_on>true</always_on>
      <update_rate>45</update_rate>
      <topic>/gripper_camera/image_raw</topic>

      <camera>
        <camera_info_topic>/gripper_camera/camera_info</camera_info_topic>

        <!-- Temporarily treat the advertised 50 deg FOV as horizontal -->
        <horizontal_fov>0.872665</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>

    <sensor name="gripper_camera_segmentation_sensor" type="segmentation">

      <!-- Must match the RGB sensor pose exactly -->
      <pose>0.007 -0.0015 0.0001 0 -1.570796 -1.570796</pose>

      <always_on>false</always_on>
      <update_rate>30</update_rate>
      <topic>/gripper_camera/segmentation</topic>

      <camera>
        <segmentation_type>semantic</segmentation_type>
        <camera_info_topic>/gripper_camera/segmentation/camera_info</camera_info_topic>

        <!-- Keep segmentation geometry identical to the RGB camera -->
        <horizontal_fov>0.872665</horizontal_fov>

        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>

        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
